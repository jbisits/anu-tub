! HyCOM-like coordinate -- regrid to a target density, bounded by a minimum interface depth
REGRIDDING_COORDINATE_MODE = "HYCOM1"

! DEFAULT, based on OM4 target densities and zstar profile
! read target densities from file, set minimum interface depth
! from profile: minimum dz=1.082, 4000m total thickness, profile is dz^4.5
ALE_COORDINATE_CONFIG = "HYBRID:hycom1_75_800m.nc,sigma2,FNC1:1.08,4000,4.5,.01"

! Initial conditions, used to initialise all runs with salinity, temperature and
! thickness initialisation from a run of Andy and Angus. Pickup time is year 500.
! NOTE: only use this to run for one month, to generate a new restart file in
! each experiment then pickup from that.
!#override TS_CONFIG = "file"
!TS_FILE = "one_degree_hycom_ics.nc"

!#override THICKNESS_CONFIG = "file"
!THICKNESS_FILE = "one_degree_hycom_ics.nc"
